     /** The BTB. */
     DefaultBTB BTB;
+
+    /**
+     * BTB-override map loaded from an annotation file at startup. When
+     * predict() is called with a PC present in this map, the BTB lookup is
+     * bypassed and the target is forced to the mapped address so fetch will
+     * speculatively redirect there; the mispredict is caught later through
+     * the normal squash path.
+     */
+    std::unordered_map<Addr, Addr> btbForcedTargets;
+
+    /**
+     * Resolution-broadcast stall map. For PCs in this map, IEW defers the
+     * post-execute broadcast (setExecuted + instToCommit + mispredict/squash
+     * dispatch) by the mapped number of cycles via a scheduled event.
+     * Populated alongside btbForcedTargets from annotation params.
+     */
+    std::unordered_map<Addr, Cycles> branchResolveStallCycles;
+
+  public:
+    /** Look up the resolve-broadcast stall for a branch PC; 0 if absent. */
+    Cycles getResolveStallCyclesFor(Addr pc) const
+    {
+        auto it = branchResolveStallCycles.find(pc);
+        return (it != branchResolveStallCycles.end()) ? it->second
+                                                       : Cycles(0);
+    }
+
+  private:
 
     /** The per-thread return address stack. */
     std::vector<ReturnAddrStack> RAS;
