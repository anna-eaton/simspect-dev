+    // Annotation-driven BTB override. If this branch's PC is in the
+    // forced-target map, bypass whatever the BTB/RAS/iPred said and redirect
+    // fetch to the annotated target. We mark the branch as taken so fetch
+    // follows the forced target; if the real target differs, the normal
+    // mispredict/squash machinery will recover when the branch resolves.
+    if (!btbForcedTargets.empty()) {
+        auto it = btbForcedTargets.find(pc.instAddr());
+        if (it != btbForcedTargets.end()) {
+            Addr forced = it->second;
+            DPRINTF(Branch,
+                    "[tid:%i] [sn:%llu] Annotation override: forcing BTB "
+                    "target at PC %#x to %#x\n",
+                    tid, seqNum, pc.instAddr(), forced);
+            // SimSpect resolve hooks (2026-10-30): forced target 1 = predict not-taken (fall-through).
+            if (it->second == 1) {
+                target.reset(pc.clone());
+                inst->advancePC(*target);
+                pred_taken = false;
+                predict_record.predTaken = false;
