+    # BTB-override annotations. Each matching index in the two vectors forms
+    # a (branch_pc -> forced_target_pc) pair. When the branch predictor is
+    # asked to predict at branch_pc, the BTB lookup is bypassed and the target
+    # is forced to forced_target_pc (with pred_taken=true), which typically
+    # produces a misprediction once the branch actually resolves.
+    annotationBranchPCs = VectorParam.Addr([],
+        "Branch PCs whose BTB output is to be overridden")
+    annotationForcedTargets = VectorParam.Addr([],
+        "Forced BTB target for each annotationBranchPCs entry")
+    # Per-branch resolution-broadcast stall (cycles past natural broadcast
+    # time after execute completes). When non-zero, IEW defers setExecuted +
+    # instToCommit + the mispredict/squash dispatch by N cycles via a
+    # scheduled event. Indices align with annotationBranchPCs.
+    annotationResolveStallCycles = VectorParam.UInt64([],
+        "Resolve-broadcast stall (cycles) per annotationBranchPCs entry")
+
