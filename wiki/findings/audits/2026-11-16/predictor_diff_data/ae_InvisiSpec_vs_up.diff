+#include "boost/algorithm/string.hpp"
 
+template<>
+inline void arrayParamOut<SatCounter>(CheckpointOut &os, const std::string &name, const std::vector<SatCounter> &param) {
+    os << name << "=";
+    for (SatCounter counter : param) {
+        os << std::to_string(counter.initialVal) << "|" << std::to_string(counter.counter) << "|" << std::to_string(counter.maxVal);
+        os << " ";
+    }
+    os << "\n";
+}
+
+template<>
+inline void arrayParamIn<SatCounter>(CheckpointIn &os, const std::string &name, std::vector<SatCounter> &param) {
+    const std::string &section(Serializable::currentSection());
+    std::string str;
+    if (!os.find(section, name, str)) {
+        fatal("Can't unserialize '%s:%s'\n", section, name);
+    }
+    param.clear();
+
+    std::vector<std::string> tokens;
+    tokenize(tokens, str, ' ');
+
+    for (std::vector<std::string>::size_type i = 0; i < tokens.size(); i++) {
+        SatCounter value;
+        std::vector<std::string> parts;
+        boost::algorithm::split(parts, tokens[i], boost::is_any_of("|"));
+        value.initialVal = std::stoi(parts[0]);
+        value.maxVal = std::stoi(parts[1]);
+        value.counter = std::stoi(parts[2]);
+
+        param.push_back(value);
+    }
+}
