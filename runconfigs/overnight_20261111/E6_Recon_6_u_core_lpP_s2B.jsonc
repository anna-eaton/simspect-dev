    "results_name": "ovn_E6_Recon_6_u_core_lpP_s2B"
  },
  "alloy": {
    "max_instances": 93041,
    "batch_size": 1000
  },
  "speculation": {
    "control_flow": true,
    "data_flow": false,
    "branch_modes": [
      "mispredict_not_taken",
      "mispredict_taken"
    ]
  },
  "gem5": {
    "binary": "/work/gem5-recon-ruby3/build/X86/gem5.opt",
    "config_script": "/work/gem5-recon-ruby3/configs/example/se_ruby.py",
    "branch_ann_enable": true,
    "cpu_type": "X86O3CPU",
    "scheme": 2,
    "caches": true,
