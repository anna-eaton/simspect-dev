// stl-prep 2026-11-12 (X4, Anna 2026-11-11: STL corpora 'in their own run like afterwards'). Stage 1b+2 for STT_6_u_stl on cafe3, = twostage_STT_6_u.jsonc with:
// STL core/lp models (both installed in the NODE SNAPSHOT only by launch_stl.sh: proposed/ultimate/STT_6_u_stl_core_ri.als, loosepin/STT_6_u_stl_lpPc.als, UNAPPROVED),
// cafe2 Stage-1 cores STT_6_u_stl_core_ri/k3 (858 cores, enumeration complete 'Total models: 858'; sha = cafe2 model = local file), stage2 = stl_final_A.jsonc
// (stl_bypass), stream.modes [stl_bypass] (new twostage_lp/stream_fp --modes), target_distinct 30000 / budget 5400 s (smaller: runs after corpus A's gem5).
{
  "paths": {
    "testset_dir": "/tests/overnight_20261111/testsets"
  },
  "twostage_lp": {
    "family": "STT_6_u_stl",
    "core_model": "STT_6_u_stl_core_ri",
    "lp_model": "STT_6_u_stl_lpP",
    "corpus": "STT_6_u_stl_core_lpP_stlA",
    "stage2_config": "runconfigs/overnight_20261111/stl_final_A.jsonc",
    "stage2_postpasses": false,
    "stage1": {
      "reuse_cores": [
        "/tests/overnight_20261111/cores/STT_6_u_stl_core_ri/k3/stage1_xml"
      ],
      "reuse_sha256": "ebf948869608cea0d8baa919f9c958337aab41dc92fa7c995c7094f0a0e0d4da"
    },
    "stage15": {
      "slots": 28,
      "job_timeout": 600,
      "budget_s": 5400,
      "cap": 100,
      "walk_p": 0.05,
      "shuffle_seed": 20261116,
      "spread": 2,
      "dedup_level": "seed",
      "xmx": "4g",
      "target_distinct": 30000
    },
    "stream": {
      "interval": 120,
      "jobs": 24,
      "min_batch": 200,
      "max_batch": 1500,
      "modes": [
        "stl_bypass"
      ]
    }
  }
}
