// Interleave-only instruction category (ilv-vocab, 2026-11-12; Anna: "add another category for interleave instrs only which aren't in the
// abstract model ... put a bunch of instructions in there as many big representatives as possible but don't do something that could mess up
// the pipeline"; RMW and jmp "just as other instructions").
//
// WHAT THIS IS. Instructions that are NOT in the abstract (Alloy) model and are only ever drawn by the random interleaving: the fanout_v2
// fillers (parsexml.py fv2_before, the `_fl_ops` uniform draw) and, if wired later, chain-interleave steps. No Alloy instruction is ever
// concretized from this table. Every entry has weight 1: the draw is uniform over `entries` with status "ok" (jmp and the six legacy fillers
// are ordinary members). Wiring: opt-in run-config key `fanout_v2.interleave_only` (see wiki/design/VOCAB_TABLES.md "Interleave-only category
// (2026-11-12)"); key absent = parsexml output byte-identical.
//
// TEMPLATE CONVENTION (same as parsexml.py FV2_FILLER_OPS): LLVM inline-asm text, AT&T syntax.
//   form "rr":   $0 = output, a register NO instruction of the program uses (parsexml `_fv2_dead`: not locked, not infrastructure, not any
//                slot, never rax/rcx/rdx), early-clobber; $1, $2 = two live registers read as inputs (may be the SAME register, may be
//                rax/rcx/rdx). Constraint string "=&{d},{s1},{s2},~{flags}" plus ",~{xmmN}" for each entry in `clobbers`.
//                ${n:k} / ${n:w} / ${n:b} = 32/16/8-bit name of operand n (LLVM x86 operand modifiers). Never ${n:h} (no high-byte
//                registers: they cannot be encoded with REX and r8-r15 have none).
//   form "none": no operands, constraint "" (like the existing VOCAB-RJ jmp filler). ${:uid} = per-asm-statement unique id.
//   $$ = literal $ (immediates); \\0A = newline between instructions.
//
// SAFETY RULES EVERY ENTRY OBEYS (checked by tools/validate_interleave_only.py on gem5, see `validation`):
//   S1 writes only $0, RFLAGS (declared ~{flags}) and the xmm registers in `clobbers`; never a program register, never rsp/rbp.
//   S2 no memory access of any kind (no memory operand, no push/pop, no stack), so no cache/LSQ/STLF effect and no Alloy memory touched.
//   S3 no control flow except the direct jmp/nop entries (jmp targets the very next instruction); no jcc, no indirect, no call/ret.
//   S4 any flag READ (adc, sbb, setcc, cmov) is preceded inside the SAME template by a flag WRITE, so its value never depends on flags set
//      outside the template. Flag placement vs Alloy compares: every template declares ~{flags} and is its own asm statement emitted before
//      the Alloy instruction (parsexml.py fv2_before, called at :2649); Alloy branches are LLVM icmp+br (parsexml.py:2621, :3009, :3090),
//      so LLVM never lets a flags-clobbering asm sit between a compare and its jcc (it re-materializes the compare after the asm).
//   S5 no fault and no trap on any input: no integer division, FP exceptions are masked (MXCSR default) so divsd/sqrtsd of any bit
//      pattern give inf/NaN, cvttsd2si of NaN gives the integer indefinite value.
//   S6 no serializing / fencing / timing / privileged instruction; nothing that changes the speculation window by itself.
//   S7 the scratch xmm registers (xmm14, xmm15) are never live across asm statements in a SimSpect program: the fpr routes
//      (parsexml.py fpr_route ~:2346) load AND move back within one asm statement, so clobbering them is free (no LLVM spill).
//
// MEASURED PER ENTRY (validate_interleave_only.py --microops stt-master, Exec trace of the template, 2026-11-12):
//   gem5_uops            the microops gem5 actually executes, as name/FU-class (IntAlu, IntMult, FloatAdd, No_OpClass, ...).
//   spt_bwd_invertible   true iff one of those microops triggers gem5-spt BACKWARD untaint (defense_src/spt_0d2be0f/src/cpu/o3/
//                        rob_impl.hh:850-881: a microop whose name is a strstr-substring of "add,addi,adc,adci,sub,subi,sbb,sbbi"
//                        with a non-zero-register dest, or a microop named exactly "mov"; then an untainted dest untaints a source).
//                        Note `movq $1, $0` is itself a "mov" microop and cmov is "mov" microops, so most templates are tagged.
//                        Fillers are unaffected (their $0 is never read, so it is never declassified); chain-interleave steps DO feed
//                        later instructions, so an SPT chain corpus should exclude tagged entries: config
//                        `interleave.interleave_only.exclude_tags: ["spt_bwd_invertible"]` (same key exists for fanout_v2).
//   spt_bwd_uops         the macroop:microop pairs that set the tag.
// Microops traced on stt-master (cafe3) and on gem5-spt itself (cafe2): identical for all 69 entries, so the SPT tag is measured on gem5-spt.
//
// gem5 citations: decoder = <tree>/src/arch/x86/isa/decoder/{one,two}_byte_opcodes.isa, microops = <tree>/src/arch/x86/isa/microops/*.isa,
// read in /Users/annaeaton/trippel/defense_src/stt_e3283b9 (stt-master) unless noted. FU class = microop op_class (regop.isa:389 IntAluOp
// default; regop.isa:547,598 IntMultOp; fpop.isa / mediaop.isa for SSE). "validated" lists the builds where the harness saw a clean run with
// the native-identical result (filled by phase 2; see `validation` at the bottom).
{
  "schema": "interleave_only/v1",
  "weighting": "uniform over entries with status ok (each weight 1)",
  "default_scratch_xmm": [14, 15],
  "entries": [
    // ---------------- legacy fanout_v2 fillers (parsexml.py FV2_FILLER_OPS, :1488-1495) + VOCAB-RJ jmp (:1510), now ordinary members ----------
    {"name": "add",  "class": "int_alu", "form": "rr", "asm": "movq $1, $0\\0Aaddq $2, $0",  "roles": {"$0": "out", "$1": "in", "$2": "in"}, "gem5": "MOV r,r + ADD r,r: mov/add microops, IntAluOp", "legacy": "FV2_FILLER_OPS.add", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu add/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["ADD_R_R:add", "MOV_R_R:mov"]},
    {"name": "xor",  "class": "int_alu", "form": "rr", "asm": "movq $1, $0\\0Axorq $2, $0",  "roles": {"$0": "out", "$1": "in", "$2": "in"}, "gem5": "xor microop, IntAluOp", "legacy": "FV2_FILLER_OPS.xor", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu xor/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["MOV_R_R:mov"]},
    {"name": "and",  "class": "int_alu", "form": "rr", "asm": "movq $1, $0\\0Aandq $2, $0",  "roles": {"$0": "out", "$1": "in", "$2": "in"}, "gem5": "and microop, IntAluOp", "legacy": "FV2_FILLER_OPS.and", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu and/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["MOV_R_R:mov"]},
    {"name": "imul", "class": "mul",     "form": "rr", "asm": "movq $1, $0\\0Aimulq $2, $0", "roles": {"$0": "out", "$1": "in", "$2": "in"}, "gem5": "IMUL Gv,Ev: mul1s + mulel, IntMultOp (regop.isa:546-547,639)", "legacy": "FV2_FILLER_OPS.imul", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu mul1s/IntMult mulel/IntAlu muleh/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["MOV_R_R:mov"]},
    {"name": "lea",  "class": "lea",     "form": "rr", "asm": "leaq ($1,$2), $0",            "roles": {"$0": "out", "$1": "base", "$2": "index"}, "gem5": "LEA: lea microop (address arithmetic, no memory access), IntAluOp", "legacy": "FV2_FILLER_OPS.lea", "weight": 1, "status": "ok", "gem5_uops": "lea/IntAlu", "spt_bwd_invertible": false, "spt_bwd_uops": []},
    {"name": "shl",  "class": "shift",   "form": "rr", "asm": "movq $1, $0\\0Ashlq $$3, $0", "roles": {"$0": "out", "$1": "in"}, "gem5": "SHL Ev,Ib: slli (Sll regop.isa:757), IntAluOp", "legacy": "FV2_FILLER_OPS.shl", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu slli/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["MOV_R_R:mov"]},
    {"name": "jmp",  "class": "control_direct", "form": "none", "asm": "jmp .Lsimspect_jf${:uid}\\0A.Lsimspect_jf${:uid}:", "roles": {}, "gem5": "JMP Jb (eb 00): wrip, direct branch predicted by the BTB/RAS-free path", "legacy": "FV2_FILLER_JMP (parsexml.py:2528-2533)", "safety": "direct, target = next instruction; adds one BTB entry and one direct-branch predictor lookup, never an indirect target", "weight": 1, "status": "ok", "gem5_uops": "rdip/IntAlu limm/IntAlu wrip/IntAlu", "spt_bwd_invertible": false, "spt_bwd_uops": []},

    // ---------------- integer ALU ----------------
    {"name": "sub",     "class": "int_alu", "form": "rr", "asm": "movq $1, $0\\0Asubq $2, $0", "roles": {"$0": "out", "$1": "in", "$2": "in"}, "gem5": "sub microop, IntAluOp", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu sub/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["MOV_R_R:mov", "SUB_R_R:sub"]},
    {"name": "or",      "class": "int_alu", "form": "rr", "asm": "movq $1, $0\\0Aorq $2, $0",  "roles": {"$0": "out", "$1": "in", "$2": "in"}, "gem5": "or microop, IntAluOp", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu or/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["MOV_R_R:mov"]},
    {"name": "adc",     "class": "int_alu", "form": "rr", "asm": "movq $1, $0\\0Aaddq $2, $0\\0Aadcq $1, $0", "roles": {"$0": "out", "$1": "in", "$2": "in"}, "gem5": "adc microop (reads CF), IntAluOp", "safety": "CF comes from the addq in the same template (S4)", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu add/IntAlu adc/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["ADC_R_R:adc", "ADD_R_R:add", "MOV_R_R:mov"]},
    {"name": "sbb",     "class": "int_alu", "form": "rr", "asm": "movq $1, $0\\0Asubq $2, $0\\0Asbbq $1, $0", "roles": {"$0": "out", "$1": "in", "$2": "in"}, "gem5": "sbb microop (reads CF), IntAluOp", "safety": "CF from the subq in the same template (S4)", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu sub/IntAlu sbb/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["MOV_R_R:mov", "SBB_R_R:sbb", "SUB_R_R:sub"]},
    {"name": "neg",     "class": "int_alu", "form": "rr", "asm": "movq $1, $0\\0Anegq $0", "roles": {"$0": "out", "$1": "in"}, "gem5": "NEG: sub from zero, IntAluOp", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu sub/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["MOV_R_R:mov", "NEG_R:sub"]},
    {"name": "not",     "class": "int_alu", "form": "rr", "asm": "movq $1, $0\\0Anotq $0", "roles": {"$0": "out", "$1": "in"}, "gem5": "NOT: xori -1 (no flags), IntAluOp", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu limm/IntAlu xor/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["MOV_R_R:mov"]},
    {"name": "inc",     "class": "int_alu", "form": "rr", "asm": "movq $1, $0\\0Aincq $0", "roles": {"$0": "out", "$1": "in"}, "gem5": "INC: addi 1, partial flag write (CF preserved: flag merge reads old CF), IntAluOp", "safety": "partial-flags write; flags clobber declared (the SPT A1 flag shape needs inc between a compare and its jcc, which LLVM forbids here; that shape stays NEEDS_EMITTER_WORK br_cmp)", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu addi/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["INC_R:addi", "MOV_R_R:mov"]},
    {"name": "dec",     "class": "int_alu", "form": "rr", "asm": "movq $1, $0\\0Adecq $0", "roles": {"$0": "out", "$1": "in"}, "gem5": "DEC: subi 1, partial flag write, IntAluOp", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu subi/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["DEC_R:subi", "MOV_R_R:mov"]},
    {"name": "add_imm", "class": "int_alu", "form": "rr", "asm": "movq $1, $0\\0Aaddq $$4097, $0", "roles": {"$0": "out", "$1": "in"}, "gem5": "addi (limm + add), IntAluOp", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu limm/IntAlu add/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["ADD_R_I:add", "MOV_R_R:mov"]},
    {"name": "add32",   "class": "int_alu", "form": "rr", "asm": "movl ${1:k}, ${0:k}\\0Aaddl ${2:k}, ${0:k}", "roles": {"$0": "out", "$1": "in", "$2": "in"}, "gem5": "32-bit add, zero-extends into the 64-bit $0, IntAluOp", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu add/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["ADD_R_R:add", "MOV_R_R:mov"]},
    {"name": "add8_merge",  "class": "partial_width", "form": "rr", "asm": "movq $1, $0\\0Aaddb ${2:b}, ${0:b}", "roles": {"$0": "out", "$1": "in", "$2": "in (low byte)"}, "gem5": "8-bit add: partial-register merge (dataSize 1), IntAluOp", "safety": "merges into $0 only", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu add/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["ADD_R_R:add", "MOV_R_R:mov"]},
    {"name": "mov16_merge", "class": "partial_width", "form": "rr", "asm": "movq $1, $0\\0Amovw ${2:w}, ${0:w}", "roles": {"$0": "out", "$1": "in", "$2": "in (low word)"}, "gem5": "16-bit mov: partial-register merge, IntAluOp", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu mov/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["MOV_R_R:mov"]},

    // ---------------- compare / test with the result materialized by setcc ----------------
    {"name": "cmp_setz",  "class": "cmp_setcc", "form": "rr", "asm": "xorl ${0:k}, ${0:k}\\0Acmpq $2, $1\\0Asetz ${0:b}",  "roles": {"$0": "out", "$1": "in", "$2": "in"}, "gem5": "CMP: sub (flags only) + SETZ Eb: ruflag/mov cc, IntAluOp (decoder two_byte_opcodes.isa:731)", "safety": "flags set by cmpq in the template (S4)", "weight": 1, "status": "ok", "gem5_uops": "xor/IntAlu sub/IntAlu movi/IntAlu movi/IntAlu", "spt_bwd_invertible": false, "spt_bwd_uops": []},
    {"name": "cmp_setb",  "class": "cmp_setcc", "form": "rr", "asm": "xorl ${0:k}, ${0:k}\\0Acmpq $2, $1\\0Asetb ${0:b}",  "roles": {"$0": "out", "$1": "in", "$2": "in"}, "gem5": "SETB Eb (two_byte_opcodes.isa:729), IntAluOp", "weight": 1, "status": "ok", "gem5_uops": "xor/IntAlu sub/IntAlu movi/IntAlu movi/IntAlu", "spt_bwd_invertible": false, "spt_bwd_uops": []},
    {"name": "cmp_setl",  "class": "cmp_setcc", "form": "rr", "asm": "xorl ${0:k}, ${0:k}\\0Acmpq $2, $1\\0Asetl ${0:b}",  "roles": {"$0": "out", "$1": "in", "$2": "in"}, "gem5": "SETL Eb (signed; reads SF,OF), IntAluOp", "weight": 1, "status": "ok", "gem5_uops": "xor/IntAlu sub/IntAlu movi/IntAlu movi/IntAlu", "spt_bwd_invertible": false, "spt_bwd_uops": []},
    {"name": "test_setnz","class": "cmp_setcc", "form": "rr", "asm": "xorl ${0:k}, ${0:k}\\0Atestq $2, $1\\0Asetnz ${0:b}", "roles": {"$0": "out", "$1": "in", "$2": "in"}, "gem5": "TEST: and (flags only) + SETNZ Eb, IntAluOp", "weight": 1, "status": "ok", "gem5_uops": "xor/IntAlu and/IntAlu movi/IntAlu movi/IntAlu", "spt_bwd_invertible": false, "spt_bwd_uops": []},

    // ---------------- cmov (condition set inside the template) ----------------
    {"name": "cmovb_min",  "class": "cmov", "form": "rr", "asm": "movq $1, $0\\0Acmpq $1, $2\\0Acmovbq $2, $0", "roles": {"$0": "out", "$1": "in", "$2": "in"}, "gem5": "CMOVB Gv,Ev (two_byte_opcodes.isa:451): conditional mov microop, IntAluOp", "safety": "unsigned min of $1,$2; flags from the cmpq (S4)", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu sub/IntAlu mov/IntAlu mov/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["CMOVB_R_R:mov", "MOV_R_R:mov"]},
    {"name": "cmovl_min",  "class": "cmov", "form": "rr", "asm": "movq $1, $0\\0Acmpq $1, $2\\0Acmovlq $2, $0", "roles": {"$0": "out", "$1": "in", "$2": "in"}, "gem5": "CMOVL Gv,Ev (two_byte_opcodes.isa:463), IntAluOp", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu sub/IntAlu mov/IntAlu mov/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["CMOVL_R_R:mov", "MOV_R_R:mov"]},
    {"name": "cmovz_test", "class": "cmov", "form": "rr", "asm": "movq $1, $0\\0Atestq $2, $2\\0Acmovzq $2, $0", "roles": {"$0": "out", "$1": "in", "$2": "in"}, "gem5": "CMOVZ Gv,Ev (two_byte_opcodes.isa:453), IntAluOp", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu and/IntAlu mov/IntAlu mov/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["CMOVZ_R_R:mov", "MOV_R_R:mov"]},

    // ---------------- shifts / rotates (immediate counts only; cl forms need rcx, see excluded) ----------------
    {"name": "shr",  "class": "shift", "form": "rr", "asm": "movq $1, $0\\0Ashrq $$7, $0",  "roles": {"$0": "out", "$1": "in"}, "gem5": "srli (Srl regop.isa:802), IntAluOp", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu srli/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["MOV_R_R:mov"]},
    {"name": "sar",  "class": "shift", "form": "rr", "asm": "movq $1, $0\\0Asarq $$11, $0", "roles": {"$0": "out", "$1": "in"}, "gem5": "srai (Sra regop.isa:847), IntAluOp", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu srai/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["MOV_R_R:mov"]},
    {"name": "rol",  "class": "shift", "form": "rr", "asm": "movq $1, $0\\0Arolq $$13, $0", "roles": {"$0": "out", "$1": "in"}, "gem5": "roli (Rol regop.isa:983), IntAluOp", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu roli/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["MOV_R_R:mov"]},
    {"name": "ror",  "class": "shift", "form": "rr", "asm": "movq $1, $0\\0Arorq $$29, $0", "roles": {"$0": "out", "$1": "in"}, "gem5": "rori (Ror regop.isa:891), IntAluOp", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu rori/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["MOV_R_R:mov"]},
    {"name": "shld", "class": "shift", "form": "rr", "asm": "movq $1, $0\\0Ashldq $$5, $2, $0", "roles": {"$0": "out", "$1": "in", "$2": "in"}, "gem5": "SHLD Ev,Gv,Ib: double shift (mdbi/sld microcode), IntAluOp", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu mdbi/IntAlu sldi/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["MOV_R_R:mov"]},
    {"name": "shrd", "class": "shift", "form": "rr", "asm": "movq $1, $0\\0Ashrdq $$9, $2, $0", "roles": {"$0": "out", "$1": "in", "$2": "in"}, "gem5": "SHRD Ev,Gv,Ib, IntAluOp", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu mdbi/IntAlu srdi/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["MOV_R_R:mov"]},

    // ---------------- bit ops ----------------
    {"name": "bt_setc", "class": "bit", "form": "rr", "asm": "xorl ${0:k}, ${0:k}\\0Abtq $2, $1\\0Asetc ${0:b}", "roles": {"$0": "out", "$1": "in", "$2": "bit index"}, "gem5": "BT Ev,Gv (two_byte_opcodes.isa:766): register form (index mod 64), no memory, IntAluOp", "weight": 1, "status": "ok", "gem5_uops": "xor/IntAlu sext/IntAlu movi/IntAlu movi/IntAlu", "spt_bwd_invertible": false, "spt_bwd_uops": []},
    {"name": "bts",     "class": "bit", "form": "rr", "asm": "movq $1, $0\\0Abtsq $2, $0", "roles": {"$0": "out", "$1": "in", "$2": "bit index"}, "gem5": "BTS Ev,Gv (two_byte_opcodes.isa:775), register form, IntAluOp", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu sext/IntAlu limm/IntAlu rol/IntAlu or/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["MOV_R_R:mov"]},
    {"name": "btr",     "class": "bit", "form": "rr", "asm": "movq $1, $0\\0Abtrq $2, $0", "roles": {"$0": "out", "$1": "in", "$2": "bit index"}, "gem5": "BTR Ev,Gv (two_byte_opcodes.isa:823), IntAluOp", "weight": 1, "status": "ok", "gem5_uops": "mov/IntAlu sext/IntAlu limm/IntAlu rol/IntAlu and/IntAlu", "spt_bwd_invertible": true, "spt_bwd_uops": ["MOV_R_R:mov"]},
