  ],

  // Candidates tested by the harness but NOT usable (kept so nobody re-proposes them without new evidence). status set by phase 2.
  "probe_only": [
    {"name": "popcnt", "class": "bit", "form": "rr", "asm": "popcntq $1, $0", "why_probe": "decoder: WarnUnimpl::popcnt_Gv_Ev in stt_e3283b9, spt_0d2be0f, amulet InvisiSpec and CleanupSpec two_byte_opcodes.isa:836; real POPCNT(Gv,Ev) only in amulet SpecLFB two_byte_opcodes.isa:791"},
    {"name": "lzcnt",  "class": "bit", "form": "rr", "asm": "lzcntq $1, $0", "why_probe": "F3 0F BD; gem5 x86 decoders read in defense_src have no lzcnt entry (expect decoded as BSR, wrong result)"},
    {"name": "tzcnt",  "class": "bit", "form": "rr", "asm": "tzcntq $1, $0", "why_probe": "F3 0F BC; no tzcnt entry (expect decoded as BSF)"}
  ],

  // Hard exclusions: never drawn. Reason per item.
  "excluded": [
    {"what": "lfence, mfence, sfence", "reason": "fences: serialize loads/stores, close or shrink the speculation window (S6)"},
    {"what": "cpuid, serialize, rdtsc, rdtscp, rdpmc, rdrand, rdseed, xgetbv", "reason": "serializing and/or timing/non-deterministic sources; cpuid and rdtscp serialize (S6)"},
    {"what": "lock-prefixed anything; xchg reg,mem; cmpxchg; cmpxchg8b/16b; xadd mem", "reason": "atomics: implicit lock, memory access, fence semantics in gem5 (S2, S6)"},
    {"what": "syscall, sysenter, int, int3, into, hlt, ud2, pause, wbinvd, in/out, iret, cli/sti", "reason": "trap / fault / privileged / sandbox escape; pause is a spin-loop hint that gem5 may treat as a delay (S5, S6)"},
    {"what": "jmp *reg, jmp *mem, call (any), ret (any), loop/jrcxz, jcc", "reason": "indirect targets (BTB indirect predictor), RSB push/pop and stack memory, new conditional branches that change the speculation structure (S3); jrcxz/loop also read rcx"},
    {"what": "any memory operand (mov/add/cmov/bt/... with an (mem) operand), push/pop, string ops (movs/stos/lods/cmps/scas, rep)", "reason": "memory access changes cache/LSQ/STLF state and may alias Alloy memory; parsexml has no scratch memory slot for fillers (only %otb_mem, private to the OTB transform at parsexml.py:2505-2510). Listed in NEEDS_EMITTER_WORK"},
    {"what": "writes to rsp/rbp; enter/leave; std/cld", "reason": "stack/frame registers; DF must stay 0 per the SysV ABI that LLVM assumes"},
    {"what": "shl/shr/sar/rol/ror/shld/shrd by %cl", "reason": "implicitly read rcx, and rcx can only be read through $1/$2; loading the count into rcx would write a program register (S1). NEEDS_EMITTER_WORK (dead-rcx variant)"},
    {"what": "mul, imul (one operand), div, idiv, cqo, cdq, cwd", "reason": "implicit rdx:rax write, and rax/rdx are never in the dead set (parsexml.py:2455); div also faults on a zero divisor or overflow (S1, S5). NEEDS_EMITTER_WORK"},
    {"what": "xchg r1,r2 with two different registers; xadd reg,reg; cmpxchg reg form", "reason": "write two registers (xchg/xadd) or implicit rax (cmpxchg); the filler emitter has one dead output. NEEDS_EMITTER_WORK (second dead output)"},
    {"what": "setcc/movzx/... on high-byte registers (ah, bh, ch, dh)", "reason": "not encodable with a REX prefix; r8-r15/rsi/rdi have no high byte"},
    {"what": "xchg r,r with the same register (xchg_self, was a candidate)", "reason": "VALIDATED WRONG on stt-master, gem5-recon-modded and /work/stt: `xchgq %r12,%r12` leaves 0 in the register instead of its value (native: value unchanged); correct on the 4 AMuLeT trees. A gem5 functional bug in the older XCHG microcode (same-register case), build-specific, so dropped (validate.log 2026-11-12 08:00 on cafe3)"},
    {"what": "lahf, sahf", "reason": "implicit ah (rax) read/write"},
    {"what": "popcnt", "reason": "WarnUnimpl in 4 of the 5 gem5 trees read (see probe_only); VALIDATED 2026-11-12: panics (`instruction 'popcnt_Gv_Ev' unimplemented`, then a wild read) on stt-master, /work/stt, amulet STT/InvisiSpec/CleanupSpec; correct on gem5-recon-modded and amulet SpecLFB. Build-specific, so not in the uniform table"},
    {"what": "lzcnt, tzcnt", "reason": "not in the gem5 decoders read: the F3 prefix is ignored and the opcode runs as BSR/BSF. VALIDATED 2026-11-12 on all 7 cafe3 builds: lzcnt(0x0123456789abcdef) = 0x38 (= bsr) vs native 0x7; lzcnt/tzcnt(0) leave the destination unchanged vs native 64"},
    {"what": "BMI1/BMI2 (andn, bextr, blsi, blsr, shlx, shrx, sarx, rorx, mulx, pdep, pext), ADX (adcx, adox)", "reason": "VEX-encoded or 0F 38 F6 forms; not decoded by these gem5 trees (three_byte_0f38_opcodes.isa lists only SSE4 pmovsx/pmovzx etc.); mulx also reads rdx"},
    {"what": "AVX, AVX2, AVX-512 (any VEX/EVEX encoding, ymm/zmm)", "reason": "gem5 x86 AVX support is partial/absent in these trees"},
    {"what": "x87 (fld, fadd, ...) and MMX (paddq mm, emms, ...)", "reason": "x87 stack/tag-word state shared between x87 and MMX; MMX needs emms; partial gem5 support; nothing in the program needs them"},
    {"what": "movnti, movntdq, maskmovq", "reason": "non-temporal stores (memory, cache bypass)"}
  ],
  "EXCLUDED_cache": [
    {"what": "clflush, clflushopt, clwb", "reason": "change cache state directly (evict/writeback a line): would change what a cache-reach checker observes. Hard-excluded; Anna to DECIDE whether a cache-state category is wanted (URGENT_TODO DECIDE ILV-1)"},
    {"what": "prefetcht0, prefetcht1, prefetcht2, prefetchnta, prefetchw", "reason": "bring lines into the cache (prefetcht0 = PREFETCH_T0(Mb) in two_byte_opcodes.isa, nta/t1/t2 WarnUnimpl); memory-addressed. Same DECIDE"}
  ],
  "NEEDS_EMITTER_WORK": [
    {"what": "memory-operand fillers (e.g. addq (scratch), $0; cmovz (scratch), $0; bt $1, (scratch))", "needs": "a private zeroed scratch array like %otb_mem (parsexml.py:2505) addressed through an infrastructure register, plus a rule that it never aliases Alloy memory; DECIDE ILV-2"},
    {"what": "shifts/rotates by %cl", "needs": "draw only when rcx is unused by the program (extend _fv2_dead to rcx for that entry) or a second dead register + an explicit `movq $2, %rcx` is impossible without writing rcx"},
    {"what": "mul/imul one-operand, div/idiv (divisor forced non-zero, e.g. `orq $$1` on a copy, and rdx zeroed)", "needs": "rax and rdx both dead in the program; parsexml always excludes them from the dead set (parsexml.py:2455), so this needs an emitter change to allow them when no Alloy slot/infrastructure uses them"},
    {"what": "xchg r1,r2 / xadd r1,r2 (two different dead registers)", "needs": "a second dead output in the filler constraint string"}
  ],
